# Product Studio — server environment
#
# Put credentials here once. Per-product Vercel project names, Supabase refs,
# and optional Cloudflare account overrides are saved through Product settings
# in the app. Never put credentials in NEXT_PUBLIC_ variables.

# Product Studio storage. Keep this set to local when you do not want Product
# Studio itself to consume a Supabase project. Data then persists on this Mac
# at .product-studio/data.json (which is intentionally excluded from Git).
DATA_SOURCE=local
# Optional alternative for temporary demo data only; it resets on restart/build.
# DATA_SOURCE=mock

# Optional: Product Studio can use a dedicated Supabase database only if you
# choose to provision one later. Leave both blank for local storage.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# DATA_SOURCE=mock

# GitHub integration (read-only, metadata only — never the source of truth).
# A classic or fine-grained PAT with read access to the mapped repositories.
# When set, the app reads live GitHub activity; when absent, the integration stays off.
GITHUB_TOKEN=
# Optional override: live | off. Default: live when GITHUB_TOKEN is set, else off.
# GITHUB_MODE=off

# Vercel deployment monitoring. Use a read-only token where possible. Each
# Product chooses its own Vercel project and optional team slug in the app.
VERCEL_ACCESS_TOKEN=
# VERCEL_TEAM_ID=
# VERCEL_MODE=off

# Supabase Management API monitoring. This may monitor either of your existing
# Supabase projects. Each Product chooses its own project ref in the app; this
# is not a Product Studio database credential.
SUPABASE_ACCESS_TOKEN=
# SUPABASE_MONITOR_MODE=off

# OpenAI meeting notes pipeline. When OPENAI_API_KEY is set, the Meeting Notes
# recorder can transcribe a saved recording and turn it into notes + tasks.
OPENAI_API_KEY=
# OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# OPENAI_SUMMARY_MODEL=gpt-5

# Cloudflare Registrar domain monitoring (read-only). Create a User API Token
# with Registrar read access; do not use a Global API Key or a NEXT_PUBLIC_
# variable. This account ID is a fallback; a Product can override it in its settings.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
